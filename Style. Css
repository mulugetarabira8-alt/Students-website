* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f3f6fb;
    color: #172033;
}

.page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 40px 15px;
}

.register-card {
    width: 100%;
    max-width: 900px;
    background: white;
    border-radius: 16px;
    padding: 35px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
}

.register-header {
    text-align: center;
    margin-bottom: 35px;
}

.school-logo {
    width: 60px;
    height: 60px;
    margin: 0 auto 15px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 50%;

    background: #2563eb;
    color: white;

    font-size: 20px;
    font-weight: bold;
}

.register-header h1 {
    font-size: 30px;
    margin-bottom: 8px;
}

.register-header p {
    color: #687386;
}


/* PROGRESS */

.progress-container {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
}

.progress-step {
    text-align: center;
    min-width: 75px;
}

.progress-step span {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: auto;

    border-radius: 50%;

    background: #e4e8ef;
    color: #687386;

    font-weight: bold;
}

.progress-step small {
    display: block;
    margin-top: 7px;
    font-size: 11px;
    color: #687386;
}

.progress-step.active span {
    background: #2563eb;
    color: white;
}

.progress-step.active small {
    color: #2563eb;
    font-weight: bold;
}

.progress-line {
    height: 2px;
    width: 45px;
    background: #e4e8ef;
}


/* FORM */

.form-step {
    display: none;
}

.form-step.active {
    display: block;
}

.form-step h2 {
    font-size: 25px;
    margin-bottom: 8px;
}

.description {
    color: #687386;
    margin-bottom: 25px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

.form-group input,
.form-group select {
    width: 100%;
    height: 50px;
    padding: 0 15px;

    border: 1px solid #d5dbe5;
    border-radius: 8px;

    font-size: 15px;
    outline: none;
}

.form-group input:focus,
.form-group select:focus {
    border-color: #2563eb;
}

.form-group small {
    display: block;
    color: #687386;
    margin-top: 6px;
}


/* UPLOAD */

.upload-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.upload-box {
    min-height: 260px;
    padding: 25px;

    text-align: center;

    border: 2px dashed #cbd3df;
    border-radius: 12px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.upload-box.small {
    min-height: 240px;
}

.upload-icon {
    font-size: 45px;
    margin-bottom: 10px;
}

.upload-box h3 {
    margin-bottom: 5px;
}

.upload-box p {
    color: #687386;
    margin-bottom: 15px;
}

.upload-box input[type="file"] {
    display: none;
}

.upload-button {
    display: inline-block;

    padding: 10px 18px;

    background: #2563eb;
    color: white;

    border-radius: 7px;

    cursor: pointer;

    font-weight: bold;
}

.image-preview {
    width: 100%;
    margin-top: 15px;
}

.image-preview img {
    width: 100%;
    max-height: 160px;

    object-fit: contain;

    border-radius: 8px;
}


/* NOTE */

.important-note {
    margin: 25px 0;
    padding: 15px;

    background: #fff8e6;
    border-left: 4px solid #f59e0b;

    border-radius: 5px;
}

.important-note p {
    margin-top: 5px;
    color: #66562e;
}


/* BUTTONS */

.button-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 30px;
}

.next-btn,
.submit-btn,
.back-btn {
    border: none;

    padding: 13px 25px;

    border-radius: 7px;

    font-size: 15px;
    font-weight: bold;

    cursor: pointer;
}

.next-btn,
.submit-btn {
    background: #2563eb;
    color: white;
    margin-left: auto;
}

.back-btn {
    background: #e8edf4;
    color: #263247;
}


/* REVIEW */

.review-box {
    border: 1px solid #e0e5ed;
    border-radius: 10px;
    overflow: hidden;
}

.review-item {
    display: flex;
    justify-content: space-between;

    padding: 15px 18px;

    border-bottom: 1px solid #e0e5ed;
}

.review-item:last-child {
    border-bottom: none;
}

.review-item span {
    color: #687386;
}

.review-item strong {
    text-align: right;
}


/* VERIFICATION */

.verification-message {
    display: flex;
    gap: 15px;

    margin-top: 25px;
    padding: 18px;

    background: #eef5ff;

    border-radius: 10px;
}

.verification-message > span {
    font-size: 25px;
}

.verification-message p {
    margin-top: 5px;
    color: #687386;
}


/* AGREEMENT */

.agreement {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    margin-top: 25px;

    color: #4c5768;
}

.agreement input {
    margin-top: 4px;
}


/* LOGIN */

.login-link {
    text-align: center;
    margin-top: 30px;
    color: #687386;
}

.login-link a {
    color: #2563eb;
    text-decoration: none;
    font-weight: bold;
}


/* MOBILE */

@media (max-width: 700px) {

    .register-card {
        padding: 22px;
    }

    .progress-container {
        overflow-x: auto;
        justify-content: flex-start;
    }

    .progress-step {
        min-width: 65px;
    }

    .progress-line {
        width: 20px;
    }

    .progress-step small {
        font-size: 9px;
    }

    .upload-grid {
        grid-template-columns: 1fr;
    }

    .button-row {
        flex-direction: column-reverse;
    }

    .next-btn,
    .submit-btn,
    .back-btn {
        width: 100%;
        margin-left: 0;
    }

    .review-item {
        flex-direction: column;
        gap: 5px;
    }

    .review-item strong {
        text-align: left;
    }

    .register-header h1 {
        font-size: 24px;
    }

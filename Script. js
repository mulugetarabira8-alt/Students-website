async function openStudent(id) {

    selectedStudentId = id;


    try {

        const result =
            await apiRequest(
                `/admin/students/${id}`
            );


        if (!result) {
            return;
        }


        if (!result.response.ok) {

            alert(
                result.data.message ||
                "Could not load student."
            );

            return;
        }


        const student =
            result.data.student;


        const name =
            `${student.first_name} ${student.second_name}`;


        document.getElementById(
            "modalStudentName"
        ).textContent = name;


        document.getElementById(
            "modalStudentEmail"
        ).textContent =
            student.email;


        document.getElementById(
            "studentDetails"
        ).innerHTML = `

            <div class="detail">

                <span>First Name</span>

                <strong>
                    ${escapeHTML(student.first_name)}
                </strong>

            </div>



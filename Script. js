/* =========================
   API REQUEST
========================= */

async function apiRequest(
    endpoint,
    options = {}
) {

    const response = await fetch(
        `${API}${endpoint}`,
        {
            ...options,

            headers: {
                "Content-Type": "application/json",

                "Authorization":
                    `Bearer ${token}`,

                ...(options.headers || {})
            }
        }
    );


    if (response.status === 401 ||
        response.status === 403) {

        sessionStorage.clear();

        window.location.href =
            "admin-login.html";

        return null;
    }


    const data =
        await response.json();

    return {
        response,
        data
    };
}



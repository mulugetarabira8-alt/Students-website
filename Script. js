================================ */

function normalizeName(name) {

    return name
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ");

}


/* ================================
   FRONTEND NAME CHECK
================================ */

function checkNameMatch() {

    const firstName = normalizeName(
        document.getElementById("firstName").value
    );

    const secondName = normalizeName(
        document.getElementById("secondName").value
    );

    const nationalName = normalizeName(
        document.getElementById("nationalIdName").value
    );


    const expectedName =
        `${firstName} ${secondName}`;


    return nationalName === expectedName;
}



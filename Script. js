    `;

}


/* =========================
   STATS
========================= */

async function updateStats() {

    try {

        const result =
            await apiRequest(
                "/admin/students/pending"
            );


        if (!result) {
            return;
        }


        const pending =
            result.data.students || [];


        document.getElementById(
            "pendingStudents"
        ).textContent =
            pending.filter(
                s => s.verification_status === "PENDING"
            ).length;


        document.getElementById(
            "reviewStudents"
        ).textContent =
            pending.filter(
                s => s.verification_status === "NEEDS_REVIEW"
            ).length;


        /*
         * This endpoint currently returns only
         * PENDING and NEEDS_REVIEW students.
         *
         * Later we'll add a statistics endpoint
         * that counts all students.
         */

        document.getElementById(
            "totalStudents"
        ).textContent =
            pending.length;


        document.getElementById(
            "verifiedStudents"
        ).textContent =
            "—";


    } catch (error) {

        console.error(error);

    }

}



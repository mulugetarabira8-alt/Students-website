async function loadStudents() {

    try {

        const result =
            await apiRequest(
                "/admin/students/pending"
            );


        if (!result) {
            return;
        }


        students =
            result.data.students || [];


        renderStudents(
            students
        );

        updateStats();


    } catch (error) {

        console.error(error);

        alert(
            "Could not load students."
        );

    }

}


/* =========================
   RENDER STUDENTS
========================= */

function renderStudents(list) {

    const html =
        list.map(function(student) {

            const name =
                `${student.first_name} ${student.second_name}`;


            return `

                <tr>

                    <td>
                        <strong>${escapeHTML(name)}</strong>
                    </td>

                    <td>
                        ${escapeHTML(student.grade)}
                    </td>

                    <td>
                        ${escapeHTML(student.email)}
                    </td>

                    <td>

                        <span class="status ${student.verification_status}">

                            ${formatStatus(
                                student.verification_status
                            )}

                        </span>

                    </td>

                    <td>

                        <button
                            class="view-button"
                            onclick="openStudent(${student.id})"
                        >
                            View
                        </button>

                    </td>

                </tr>

            `;

        }).join("");


    studentTableBody.innerHTML =
        html || emptyTable();


    studentListBody.innerHTML =
        html || emptyTable();

}


function emptyTable() {

    return `

        <tr>

            <td
                colspan="5"
                style="text-align:center;padding:40px;"
